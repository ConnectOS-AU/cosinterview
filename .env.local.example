# Copy this file to .env.local and fill in real values.
# .env.local is gitignored - never commit real secrets.

# --- Site ---
# Public URL of the candidate portal, e.g. https://interviews.connectos.co
# (http://localhost:3008 in dev). Used to build invite and join links.
NEXT_PUBLIC_SITE_URL=https://interviews.connectos.co

# COSHub's public address. Only this origin may frame the recruiter screens (/r).
COSHUB_ORIGIN=https://coshub.connectos.co

# --- Supabase (ConnectOS Database) ---
# Recruiter sign-in uses Supabase Auth's Azure provider, like COSHub. Add
# <NEXT_PUBLIC_SITE_URL>/r/auth/callback to Supabase Auth > URL Configuration > Redirect URLs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Share the sign-in with COSHub: set to .connectos.co here and in COSHub, so signing
# in to either signs you in to both. Leave unset for local dev.
AUTH_COOKIE_DOMAIN=
# Server-side only. Candidate pages reach the database through server routes
# that use this key; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Daily (video interviews) ---
DAILY_API_KEY=
# Your Daily subdomain, e.g. connectos for connectos.daily.co
DAILY_DOMAIN=connectos.daily.co
# Shared secret for verifying Daily webhooks (recording ready). Base64, e.g.
# `openssl rand -base64 32`; pass the same value as "hmac" when creating the webhook.
DAILY_WEBHOOK_SECRET=

# --- AWS S3 (Daily raw-tracks recordings land here) ---
RECORDINGS_S3_BUCKET=
RECORDINGS_S3_REGION=
# Read-only access to that bucket for the transcription worker (or use the
# server's instance role and leave these empty).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Transcription worker ---
# ffmpeg must be installed on the server; set the full path if it isn't on PATH.
FFMPEG_PATH=
# Bearer token for POST /api/worker/run (the retry job). Any long random string.
WORKER_SECRET=

# --- Groq (Whisper translate: Tagalog/English audio -> English text) ---
GROQ_API_KEY=

# --- Anthropic (interview summary) ---
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5.
SUMMARY_MODEL=

# --- JobAdder ---
# Used only to refresh the token the existing JobAdder sync stores in ja_token.
JOBADDER_CLIENT_ID=
JOBADDER_CLIENT_SECRET=
# Optional: the API base from JobAdder's token response, and the note type.
JOBADDER_API_URL=
JOBADDER_NOTE_TYPE=Internal interview

# --- SendGrid (all candidate emails: invites, confirmations, cancellations) ---
# Same account as COSHub. Sent from SENDGRID_FROM_EMAIL (a verified sender) as
# "<recruiter> at <SENDGRID_FROM_NAME>", with replies going to the recruiter.
# EMAIL_DRY_RUN=true logs emails instead of sending them.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=ConnectOS
EMAIL_DRY_RUN=

# --- Infobip (WhatsApp and Viber, for candidates who give their numbers) ---
# WhatsApp uses an approved utility template whose body is a single {{1}}.
# Until these are filled in, numbers are saved but nothing is sent.
# MESSAGING_DRY_RUN=true logs the messages instead of sending them.
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_WHATSAPP_SENDER=
INFOBIP_WHATSAPP_TEMPLATE=cosinterview_update
INFOBIP_WHATSAPP_LANGUAGE=en
INFOBIP_VIBER_SENDER=
MESSAGING_DRY_RUN=

# --- Microsoft Graph (recruiters' free/busy and Outlook entries) ---
# Application permission Calendars.ReadWrite, limited to recruiter mailboxes with
# an application access policy. (Mail.Send isn't needed - emails use SendGrid.)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Until Graph is set up: true lets candidates book from working hours, avoiding
# only times already booked in COSInterview (not the recruiter's other meetings),
# and no Outlook entries are made. Remove once the MS_ values are filled in.
CALENDAR_OPTIONAL=
