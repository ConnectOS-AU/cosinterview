# Copy this file to .env.local and fill in real values.
# .env.local is gitignored - never commit real secrets.

# --- Site ---
# Public URL of the candidate portal, e.g. https://interviews.connectos.co
# (http://localhost:3000 in dev). Used to build invite and join links.
NEXT_PUBLIC_SITE_URL=

# COSHub's public address. Only this origin may frame the recruiter screens (/r).
COSHUB_ORIGIN=https://coshub.connectos.co

# --- Supabase (ConnectOS Database) ---
# Recruiter sign-in uses Supabase Auth's Azure provider, like COSHub. Add
# <NEXT_PUBLIC_SITE_URL>/r/auth/callback to Supabase Auth > URL Configuration > Redirect URLs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Candidate pages reach the database through server routes
# that use this key; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Daily (video interviews) ---
DAILY_API_KEY=
# Your Daily subdomain, e.g. connectos for connectos.daily.co
DAILY_DOMAIN=
# Shared secret for verifying Daily webhooks (recording ready, etc.)
DAILY_WEBHOOK_SECRET=

# --- AWS S3 (Daily raw-tracks recordings land here) ---
RECORDINGS_S3_BUCKET=
RECORDINGS_S3_REGION=

# --- Groq (Whisper translate: Tagalog/English audio -> English text) ---
GROQ_API_KEY=

# --- JobAdder ---
JOBADDER_CLIENT_ID=
JOBADDER_CLIENT_SECRET=

# --- Microsoft Graph (recruiter free/busy + Outlook calendar entries) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
